{
  "name": "@putdotio/vref",
  "version": "1.1.0",
  "description": "put.io visual reference CLI for curated screenshots and agent-readable UI evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putdotio/vref.git"
  },
  "bin": {
    "vref": "./dist/cli.mjs"
  },
  "files": [
    "AGENTS.md",
    "dist",
    "docs",
    "README.md",
    "SECURITY.md",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/cli.ts --dts",
    "check": "vp check .",
    "clean": "rm -rf coverage dist",
    "describe": "node ./dist/cli.mjs describe --output json",
    "pack:dry": "vp pack src/index.ts src/cli.ts --dts && npm pack --dry-run",
    "prepack": "vp pack src/index.ts src/cli.ts --dts",
    "test": "vp test",
    "verify": "vp check . && vp pack src/index.ts src/cli.ts --dts && vp test && npm pack --dry-run"
  },
  "dependencies": {
    "effect": "beta"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.2.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
