{
  "name": "@putdotio/vref",
  "version": "1.2.4",
  "description": "put.io visual reference CLI for curated screenshots and agent-readable UI evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putdotio/vref.git"
  },
  "bin": {
    "vref": "./dist/cli.mjs"
  },
  "files": [
    "AGENTS.md",
    "dist",
    "docs",
    "README.md",
    "SECURITY.md",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/cli.ts --dts",
    "check": "vp check .",
    "clean": "rm -rf coverage dist",
    "describe": "node ./dist/cli.mjs describe --output json",
    "hooks:install": "git config core.hooksPath .git-hooks",
    "pack:dry": "vp pack src/index.ts src/cli.ts --dts && npm pack --dry-run",
    "prepack": "vp pack src/index.ts src/cli.ts --dts",
    "skills:lint": "skillcheck lint",
    "smoke": "node ./scripts/smoke.ts",
    "test": "vp test",
    "typecheck": "tsc --noEmit --rootDir .",
    "verify": "vp check . && skillcheck lint && vp run typecheck && vp pack src/index.ts src/cli.ts --dts && vp run smoke && vp test && npm pack --dry-run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@uinaf/skillcheck": "0.5.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@12.0.0"
}
