{
  "name": "@putdotio/vref",
  "version": "0.0.0-development",
  "description": "put.io visual reference CLI for curated screenshots and agent-readable UI evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putdotio/vref.git"
  },
  "bin": {
    "vref": "dist/cli.js"
  },
  "files": [
    "dist",
    ".agents/skills/vref/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "check": "vp check .",
    "clean": "rm -rf coverage dist",
    "describe": "node ./dist/cli.js describe --output json",
    "pack:dry": "pnpm pack --dry-run",
    "test": "vitest run",
    "verify": "pnpm run check && pnpm run build && pnpm run test && pnpm run pack:dry"
  },
  "dependencies": {
    "effect": "beta"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.20",
    "vite-plus": "^0.1.20",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@11.1.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "msgpackr-extract"
    ]
  }
}
